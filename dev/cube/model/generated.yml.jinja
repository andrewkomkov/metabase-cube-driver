cubes:
{%- for status in ['completed', 'shipped'] %}
  - name: gen_{{ status | safe }}_orders
    title: Generated {{ status | safe }} orders
    description: Generated by a Jinja loop.
    sql: "SELECT * FROM shop.orders WHERE status = '{{ status | safe }}'"
    dimensions:
      - { name: id, sql: id, type: number, primary_key: true }
    measures:
      - { name: count, type: count, description: Orders with status {{ status | safe }}. }
      - { name: revenue, sql: amount, type: sum, description: Revenue with status {{ status | safe }}. }
{%- endfor %}
