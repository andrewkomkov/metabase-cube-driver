  {
   "id": "sql_together",
   "sql": "SELECT u.id, u.lifetime_orders, u.paid_orders FROM users u CROSS JOIN orders o WHERE u.__cubeJoinField = o.__cubeJoinField AND o.status = 'early' GROUP BY 1,2,3 ORDER BY 1"
